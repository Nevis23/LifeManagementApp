<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LifeManagementApp.TodoPage"
    Title="My Todos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="My Todos"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
                Text="Manage your daily tasks"
                FontSize="14"
                TextColor="Gray" />

            <Label
                Text="Sort tasks"
                FontSize="22"
                FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="10">

                <Button
                    Text="By priority"
                    Command="{Binding SortByPriorityCommand}" />

                <Button
                    Text="By due date"
                    Command="{Binding SortByDueDateCommand}" />

            </HorizontalStackLayout>

            <Label
                Text="My tasks"
                FontSize="22"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Todos}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="12"
                            Margin="0,5"
                            CornerRadius="10"
                            BackgroundColor="#F0F0F0">

                            <VerticalStackLayout Spacing="5">

                                <VerticalStackLayout Spacing="5">

                                    <Grid ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10">

                                        <CheckBox
                                            Grid.Column="0"
                                            IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                            CheckedChanged="OnTodoCheckedChanged" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="Black"
                                            VerticalOptions="Center" /> 
                                    </Grid>

                                    <Label
                                        Text="{Binding Description}"
                                        FontSize="14"
                                        TextColor="Gray" />

                                    <Label
                                        Text="{Binding Priority, StringFormat='Priority: {0}'}"
                                        TextColor="{Binding PriorityColor}"
                                        FontAttributes="Bold"
                                        FontSize="13" />

                                    <Label
                                        Text="{Binding DueDate, StringFormat='Due date: {0:dd.MM.yyyy}'}"
                                        TextColor="{Binding DueDateColor}"
                                        FontSize="13" />

                                    <Label
                                        Text="{Binding Priority, StringFormat='Priority: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Label
                                        Text="{Binding DueDate, StringFormat='Due date: {0:dd.MM.yyyy}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Button
                                        Text="Delete"
                                        BackgroundColor="#DC2626"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                          Path=BindingContext.DeleteTodoCommand}"
                                        CommandParameter="{Binding .}" />
                                        <!-- etsii DeleteTodoCommand komennon-->
                                </VerticalStackLayout>

                            </VerticalStackLayout>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="Add new task"
                FontSize="22"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Enter task title..."
                Text="{Binding NewTodoTitle}" />

            <Label
                Text="Priority"
                FontAttributes="Bold" />    

            <Picker
                Title="Select priority"
                ItemsSource="{Binding PriorityOptions}"
                SelectedItem="{Binding SelectedPriority}" />

            <Label
                Text="Due date"
                FontAttributes="Bold" />

            <DatePicker
                Date="{Binding NewTodoDueDate}"
                Format="dd.MM.yyyy" />

            <Button
                Text="Add Todo"
                Command="{Binding AddTodoCommand}"
                BackgroundColor="#2563EB"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
